{
  "title": "ObserveOps — LLM & RAG Metrics",
  "uid": "observeops-llm",
  "description": "LLMOps observability: query rates, latency, grounding quality, and vector store health",
  "tags": ["observeops", "llm", "rag", "mlops"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "panels": [

    {
      "id": 1,
      "title": "Total RAG Queries",
      "description": "Cumulative queries through the RAG pipeline since startup",
      "type": "stat",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "targets": [{
        "datasource": { "type": "prometheus" },
        "expr": "sum(rag_queries_total)",
        "legendFormat": "Total Queries"
      }],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "thresholds" },
          "thresholds": { "steps": [{ "color": "blue", "value": null }] }
        }
      }
    },

    {
      "id": 2,
      "title": "LLM Error Rate",
      "description": "Fraction of LLM calls returning errors. Alert fires at 10%.",
      "type": "stat",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "targets": [{
        "datasource": { "type": "prometheus" },
        "expr": "(rate(llm_requests_total{status=\"error\"}[10m]) / rate(llm_requests_total[10m])) * 100",
        "legendFormat": "Error Rate %"
      }],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "red", "value": 10 }
            ]
          }
        }
      }
    },

    {
      "id": 3,
      "title": "Grounded Response Rate",
      "description": "Fraction of answers grounded in retrieved context. Low = knowledge base needs more documents.",
      "type": "stat",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "targets": [{
        "datasource": { "type": "prometheus" },
        "expr": "(rate(rag_queries_total{grounded=\"true\"}[10m]) / rate(rag_queries_total[10m])) * 100",
        "legendFormat": "Grounded %"
      }],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "green", "value": 75 }
            ]
          }
        }
      }
    },

    {
      "id": 4,
      "title": "Vector Store Size",
      "description": "Number of document chunks in FAISS. Grows as you POST to /ingest.",
      "type": "stat",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "targets": [{
        "datasource": { "type": "prometheus" },
        "expr": "vector_store_documents_total",
        "legendFormat": "Chunks"
      }],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "steps": [{ "color": "blue", "value": null }] }
        }
      }
    },

    {
      "id": 5,
      "title": "LLM Response Latency (percentiles)",
      "description": "p50/p95/p99 latency of LLM API calls. Groq is usually <2s. Alert at p95>15s.",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 4, "w": 16, "h": 8 },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "histogram_quantile(0.99, rate(llm_request_duration_seconds_bucket[5m]))",
          "legendFormat": "p99"
        },
        {
          "datasource": { "type": "prometheus" },
          "expr": "histogram_quantile(0.95, rate(llm_request_duration_seconds_bucket[5m]))",
          "legendFormat": "p95"
        },
        {
          "datasource": { "type": "prometheus" },
          "expr": "histogram_quantile(0.50, rate(llm_request_duration_seconds_bucket[5m]))",
          "legendFormat": "p50 (median)"
        }
      ],
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "lineWidth": 2 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "red", "value": 15 }
            ]
          }
        }
      }
    },

    {
      "id": 6,
      "title": "Query Rate",
      "description": "RAG queries per minute",
      "type": "timeseries",
      "gridPos": { "x": 16, "y": 4, "w": 8, "h": 8 },
      "targets": [{
        "datasource": { "type": "prometheus" },
        "expr": "rate(rag_queries_total[5m]) * 60",
        "legendFormat": "Queries/min"
      }],
      "options": {
        "tooltip": { "mode": "single" },
        "legend": { "displayMode": "hidden" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "lineWidth": 2, "fillOpacity": 20 }
        }
      }
    },

    {
      "id": 7,
      "title": "Grounded vs Ungrounded Responses",
      "description": "Pie chart of answer quality. Large ungrounded slice = enrich the knowledge base.",
      "type": "piechart",
      "gridPos": { "x": 0, "y": 12, "w": 10, "h": 8 },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "sum(rag_queries_total{grounded=\"true\"})",
          "legendFormat": "Grounded"
        },
        {
          "datasource": { "type": "prometheus" },
          "expr": "sum(rag_queries_total{grounded=\"false\"})",
          "legendFormat": "Ungrounded"
        }
      ],
      "options": {
        "pieType": "donut",
        "displayLabels": ["name", "percent"],
        "legend": { "displayMode": "table", "placement": "right" }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Grounded" },   "properties": [{ "id": "color", "value": { "fixedColor": "green",  "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "Ungrounded" }, "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }] }
        ]
      }
    },

    {
      "id": 8,
      "title": "Documents Retrieved per Query",
      "description": "Distribution of how many FAISS chunks are returned per query. Consistent 4 = healthy.",
      "type": "timeseries",
      "gridPos": { "x": 10, "y": 12, "w": 14, "h": 8 },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "histogram_quantile(0.99, rate(rag_documents_retrieved_bucket[5m]))",
          "legendFormat": "p99 docs retrieved"
        },
        {
          "datasource": { "type": "prometheus" },
          "expr": "histogram_quantile(0.50, rate(rag_documents_retrieved_bucket[5m]))",
          "legendFormat": "p50 docs retrieved"
        }
      ],
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "table", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": { "lineWidth": 2 }
        }
      }
    }

  ]
}
