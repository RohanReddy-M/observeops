# Environment — never commit real secrets
.env
.env.local
.env.*.local

# Terraform state
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.*
terraform/*.tfvars
# terraform/.terraform.lock.hcl is deliberately NOT ignored. It pins the exact provider
# builds (with checksums for linux and windows) so every `terraform init` installs
# what was tested. Ignoring it meant each machine resolved "~> 5.0" on its own.
terraform/tfplan

# Python
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.venv/
venv/
*.egg-info/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp

# Logs
*.log

# Build
dist/
build/

# Lambda deployment artifacts — generated by CI, not committed
terraform/modules/lambda/*.zip

# AlertManager webhook URLs are secrets, written at deploy time. Never commit them.
monitoring/alertmanager/secrets/*
!monitoring/alertmanager/secrets/README.md

# Game-day state, history and the temporary compose override
.gameday/
