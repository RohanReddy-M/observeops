# ─── Environment Variables Template ──────────────────────────────────────────
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# .env is in .gitignore — it will NEVER be committed to git.
# Regenerate any key that was ever accidentally shared.

# ── Required: LLM API ─────────────────────────────────────────────────────────
# Free at console.groq.com — no credit card needed.
# Used by: ragservice (AI incident assistant) + llm-alert-autopilot (alert diagnosis)
GROQ_API_KEY=gsk_your_key_here

# ── Optional: AWS (leave blank to run fully local without AWS) ────────────────
# DynamoDB table — leave empty to use in-memory ship data (no AWS needed for local dev)
DYNAMODB_TABLE=

# ── Optional: Slack alerts ────────────────────────────────────────────────────
# Get a webhook at api.slack.com/messaging/webhooks
# Without this, alerts are logged but not sent to Slack (local dev is fine without it)
SLACK_WEBHOOK_URL=

# ── Optional: Grafana (defaults work for local dev, don't change unless needed) ─
# Default Grafana password — change in production
GRAFANA_PASSWORD=observeops123
