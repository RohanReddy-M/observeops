# Copy this file to .env and fill in real values.
# Never commit .env: it is in .gitignore.
# On AWS this file is written for you (by the servers' boot scripts and deploy.sh,
# from SSM Parameter Store); you only maintain it by hand on a laptop.

# Groq API key: free at console.groq.com. Without it the RAG service and the
# alert autopilot start, and report every LLM call as failed.
GROQ_API_KEY=your_groq_api_key_here

# Optional. Which Groq model to call. Leave unset to use the default in the code.
# Providers retire models; when that happens, set this and restart (ADR-010).
# GROQ_MODEL=

# Optional. Slack incoming webhook for the autopilot's diagnosis messages.
# Empty = the diagnosis is logged and not posted.
SLACK_WEBHOOK_URL=

# Optional, local only. Turn API-key authentication on to see it work:
# SECURESHIP_API_KEY=choose-any-string
# REQUIRE_API_KEY=true

# Optional, local only. Grafana's admin password the FIRST time its data volume
# is created (default: observeops123). Production generates its own.
# GRAFANA_ADMIN_PASSWORD=
