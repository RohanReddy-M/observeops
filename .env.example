# Copy this file to .env and fill in real values.
# Never commit .env — it is in .gitignore.

# Groq API key — get one free at console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Slack incoming webhook URL for AI autopilot alerts
# Create at: api.slack.com/apps -> Incoming Webhooks -> Add New Webhook
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# AWS settings (only needed for production — not required for local dev)
DYNAMODB_TABLE=
AWS_DEFAULT_REGION=ap-south-1
